diff --git a/packages/tui/src/ui/rsvp-zone.tsx b/packages/tui/src/ui/rsvp-zone.tsx
new file mode 100644
index 000000000..c3419c0fc
--- /dev/null
+++ b/packages/tui/src/ui/rsvp-zone.tsx
@@ -0,0 +1,172 @@
+/** @jsxImportSource @opentui/solid */
+import { createEffect, createSignal, onCleanup, Show } from "solid-js"
+import { useTheme } from "../context/theme"
+import {
+  RSVP_ANCHOR_COL,
+  RSVP_STARVE_MS,
+  RsvpTokenizer,
+  type RsvpEvent,
+} from "../util/rsvp"
+
+type Props = {
+  // Texto acumulado do thought (content() do ReasoningPart). Só cresce.
+  text: () => string
+  // True quando o thought fechou (time.end). A zona drena a cauda em skim.
+  done: () => boolean
+  // Chamado p/ cada bloco desviado — o pai anexa ao markdown final.
+  onBypass?: (content: string) => void
+  // Fila zerada após done (ou teto da cauda): pode consolidar o markdown.
+  onDrained?: () => void
+}
+
+// Paleta da zona (canônico Spritz na forma, Vostok na cor): palavra UNIFORME
+// branca bold + SÓ a letra-pivô em VERMELHO BRILHANTE (#ff3e3e, o scoriaRed
+// oficial: +18% de luminância sobre o puro sem virar rosa).
+// Sem bg, sem peso dividido: marcação além da cor do pivô é ruído.
+export const RSVP_WORD_FG = "#ffffff" as const
+export const RSVP_ORP = "#ff3e3e" as const
+
+function widthOf(s: string): number {
+  try {
+    return Bun.stringWidth(s)
+  } catch {
+    return [...s].length
+  }
+}
+
+/**
+ * Zona RSVP thought-only: consome o stream do reasoning e exibe palavra por
+ * palavra com a ORP em vermelho, âncora em coluna fixa. Sem clique, sem
+ * replay — só ao vivo. Quando o thought fecha, o pai desmonta a zona.
+ */
+export function RsvpZone(props: Props) {
+  const { theme } = useTheme()
+  const tokenizer = new RsvpTokenizer()
+  let consumed = ""
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let running = false
+
+  const [word, setWord] = createSignal("")
+  const [orp, setOrp] = createSignal(0)
+  const [seq, setSeq] = createSignal(0)
+  const [total, setTotal] = createSignal(0)
+  const [starved, setStarved] = createSignal(false)
+  const queue: RsvpEvent[] = []
+  let totalEvents = 0
+  let lastIngestAt = 0
+  let drainedNotified = false
+
+  const stop = () => {
+    running = false
+    if (timer !== undefined) {
+      clearTimeout(timer)
+      timer = undefined
+    }
+  }
+  onCleanup(stop)
+
+  const finishTail = () => {
+    queue.length = 0
+    stop()
+    if (!drainedNotified) {
+      drainedNotified = true
+      props.onDrained?.()
+    }
+  }
+
+  const tick = () => {
+    timer = undefined
+    const ev = queue.shift()
+    if (!ev) {
+      // Thought fechou e fila zerou: TUDO foi exibido → consolida.
+      if (props.done()) {
+        finishTail()
+        return
+      }
+      // Fila seca com stream vivo: mostra "···" em vez de silêncio.
+      // Publica só na transição (o re-cheque é a cada 300ms).
+      if (Date.now() - lastIngestAt > RSVP_STARVE_MS && !starved()) {
+        setStarved(true)
+      }
+      timer = setTimeout(tick, 300)
+      return
+    }
+    setStarved(false)
+    if (ev.type === "word") {
+      setWord(ev.word)
+      setOrp(ev.orpIndex)
+      setSeq(ev.seq)
+    }
+    running = true
+    // Ritmo CRAVADO: sem catch-up (ele variava a velocidade com a rajada).
+    // Rajada acumula na fila sem limite; a cauda drena tudo depois, no mesmo
+    // ritmo. Steady + completo, sem trade-off.
+    const delay = ev.type === "word" ? ev.delayMs : 0
+    timer = setTimeout(tick, Math.max(0, delay))
+  }
+
+  const kick = () => {
+    if (!running && queue.length > 0) {
+      running = true
+      timer = setTimeout(tick, 0)
+    }
+  }
+
+  const ingest = (events: RsvpEvent[]) => {
+    if (events.length > 0) lastIngestAt = Date.now()
+    setStarved(false)
+    for (const ev of events) {
+      // Total conta palavras + desvios: o denominador anda mesmo em código.
+      totalEvents += 1
+      setTotal(totalEvents)
+      if (ev.type === "bypass") {
+        props.onBypass?.(ev.content)
+        continue
+      }
+      queue.push(ev)
+    }
+    kick()
+  }
+
+  createEffect(() => {
+    const text = props.text()
+    const done = props.done()
+    if (!text.startsWith(consumed)) {
+      tokenizer.reset()
+      queue.length = 0
+      consumed = ""
+    }
+    const suffix = text.slice(consumed.length)
+    consumed = text
+    if (suffix) ingest(tokenizer.push(suffix))
+    // Thought fechou: descarrega a última palavra (segurada sem trailing
+    // space) + resto sem fecho. Sem isso, todo thought perdia o final.
+    if (done) ingest(tokenizer.flush())
+    // Done com fila zerada e loop parado: consolida sem esperar o timer.
+    if (props.done() && queue.length === 0) finishTail()
+  })
+
+  const chars = () => [...word()]
+  const before = () => chars().slice(0, orp()).join("")
+  const anchor = () => chars()[orp()] ?? ""
+  const after = () => chars().slice(orp() + 1).join("")
+  const pad = () => " ".repeat(Math.max(0, RSVP_ANCHOR_COL - widthOf(before())))
+
+  return (
+    <Show when={word() || starved()}>
+      <box marginTop={1} flexDirection="column" flexShrink={0}>
+        <text wrapMode="none">
+          <Show
+            when={!starved()}
+            fallback={<span style={{ fg: theme.textMuted }}>···</span>}
+          >
+            {pad()}
+            <span style={{ fg: RSVP_WORD_FG, bold: true }}>{before()}</span>
+            <span style={{ fg: RSVP_ORP, bold: true }}>{anchor()}</span>
+            <span style={{ fg: RSVP_WORD_FG, bold: true }}>{after()}</span>
+          </Show>
+        </text>
+      </box>
+    </Show>
+  )
+}
