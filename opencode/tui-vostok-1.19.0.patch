+      const char = glyph.ch
+      const t = width <= 1 ? 0 : index / (width - 1)
+      const fg = core ? CORE_FG : lerp(GRAD_FROM, GRAD_TO, t)
+      const shadow = tint(theme.background, fg, 0.25)
+      const attrs = TextAttributes.BOLD
+      if (!glyph.lit && char === "_") {
         return (
