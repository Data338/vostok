index 000000000..7d49740f2
--- /dev/null
+++ b/packages/tui/test/util/rsvp-zone.test.tsx
@@ -0,0 +1,153 @@
+/** @jsxImportSource @opentui/solid */
+import { testRender } from "@opentui/solid"
+import { expect, test } from "bun:test"
+import { mkdir } from "node:fs/promises"
+import path from "node:path"
+import { createSignal } from "solid-js"
+import { tmpdir } from "../fixture/fixture"
+import { createTuiResolvedConfig } from "../fixture/tui-runtime"
+import { TestTuiContexts } from "../fixture/tui-environment"
+
+async function wait(fn: () => boolean, timeout = 8000) {
+  const start = Date.now()
+  while (!fn()) {
+    if (Date.now() - start > timeout) throw new Error("timed out waiting for condition")
+    await Bun.sleep(25)
+  }
+}
+
+function frame(app: { captureCharFrame: () => string }) {
+  return app.captureCharFrame()
+}
+
+async function mountZone(input: {
+  root: string
+  initial: string
+  onBypass: (c: string) => void
+  onDrained?: () => void
+  done?: () => boolean
+}) {
+  const state = path.join(input.root, "state")
+  await mkdir(state, { recursive: true })
+  await Bun.write(path.join(state, "kv.json"), "{}")
+
+  const [{ KVProvider }, { TuiConfigProvider }, { ThemeProvider }, { RsvpZone }] = await Promise.all([
+    import("../../src/context/kv"),
+    import("../../src/config"),
+    import("../../src/context/theme"),
+    import("../../src/ui/rsvp-zone"),
+  ])
+
+  const [text, setText] = createSignal(input.initial)
+
+  function Harness() {
+    const resolvedConfig = createTuiResolvedConfig({})
+    return (
+      <TestTuiContexts
+        directory={input.root}
+        paths={{ home: input.root, state, worktree: input.root }}
+      >
+        <TuiConfigProvider config={resolvedConfig}>
+          <KVProvider>
+            <ThemeProvider mode="dark">
+              <RsvpZone
+                text={text}
+                done={input.done ?? (() => false)}
+                onBypass={input.onBypass}
+                onDrained={input.onDrained}
+              />
+            </ThemeProvider>
+          </KVProvider>
+        </TuiConfigProvider>
+      </TestTuiContexts>
+    )
+  }
+
+  const app = await testRender(() => <Harness />, { width: 80, height: 6 })
+  return { app, setText, cleanup: () => app.renderer.destroy() }
+}
+
+test("rsvp zone drena palavras com contador progressivo", async () => {
+  await using tmp = await tmpdir()
+  const bypassed: string[] = []
+  const zone = await mountZone({ root: tmp.path, initial: "", onBypass: (c) => bypassed.push(c) })
+  try {
+    zone.setText("O rato roeu a roupa. ")
+    await wait(() => frame(zone.app).includes("rato"))
+    await wait(() => frame(zone.app).includes("roupa."))
+    expect(frame(zone.app)).toContain("roupa.")
+    expect(frame(zone.app)).not.toMatch(/\d+\/\d+/)
+    expect(bypassed).toEqual([])
+  } finally {
+    zone.cleanup()
+  }
+})
+
+test("rsvp zone não come a última palavra (flush no done)", async () => {
+  await using tmp = await tmpdir()
+  const [done, setDone] = createSignal(false)
+  let drained = false
+  const zone = await mountZone({
+    root: tmp.path,
+    initial: "",
+    onBypass: () => {},
+    done,
+    onDrained: () => {
+      drained = true
+    },
+  })
+  try {
+    // Sem trailing space (igual o content() trimado do ReasoningPart):
+    // a última palavra fica segurada até o flush do done.
+    zone.setText("o fim")
+    await wait(() => frame(zone.app).includes("o"))
+    expect(frame(zone.app)).not.toContain("fim")
+    setDone(true)
+    await wait(() => frame(zone.app).includes("fim"))
+    await wait(() => drained)
+    expect(drained).toBe(true)
+  } finally {
+    zone.cleanup()
+  }
+})
+
+test("rsvp zone drena cauda após done e avisa onDrained", async () => {
+  await using tmp = await tmpdir()
+  const [done, setDone] = createSignal(false)
+  let drained = false
+  const zone = await mountZone({
+    root: tmp.path,
+    initial: "",
+    onBypass: () => {},
+    done,
+    onDrained: () => {
+      drained = true
+    },
+  })
+  try {
+    // Enfileira 3 palavras e fecha o thought no meio da drenagem.
+    zone.setText("um dois três ")
+    await wait(() => frame(zone.app).includes("dois"))
+    setDone(true)
+    // Cauda em skim (~130ms/palavra): drena e dispara onDrained.
+    await wait(() => drained)
+    expect(drained).toBe(true)
+    expect(frame(zone.app)).toContain("três")
+  } finally {
+    zone.cleanup()
+  }
+})
+
+test("rsvp zone desvia fence e continua na prosa", async () => {
+  await using tmp = await tmpdir()
+  const bypassed: string[] = []
+  const zone = await mountZone({ root: tmp.path, initial: "veja ", onBypass: (c) => bypassed.push(c) })
+  try {
+    zone.setText("veja ```ts\nconst a = 1\n``` depois ")
+    await wait(() => bypassed.length > 0)
+    expect(bypassed.join("\n")).toContain("const a = 1")
+    await wait(() => frame(zone.app).includes("depois"))
+  } finally {
+    zone.cleanup()
+  }
+})
diff --git a/packages/tui/test/util/rsvp.test.ts b/packages/tui/test/util/rsvp.test.ts
new file mode 100644
index 000000000..a84fc940a
--- /dev/null
+++ b/packages/tui/test/util/rsvp.test.ts
@@ -0,0 +1,135 @@
+import { describe, expect, test } from "bun:test"
+import { frameDelay, orpIndex, RSVP_BASE_MS, RsvpTokenizer } from "../../src/util/rsvp"
+
+describe("orpIndex", () => {
+  test("tabela ~1/3 (base SeanZoR)", () => {
+    expect(orpIndex("a")).toBe(0)
+    expect(orpIndex("oi")).toBe(1)
+    expect(orpIndex("casa!")).toBe(1)
+    expect(orpIndex("palavra")).toBe(2)
+    expect(orpIndex("rapidamente")).toBe(3)
+    expect(orpIndex("computadores")).toBe(3)
+    expect(orpIndex("inconstitucionalmente")).toBe(4)
+  })
+})
+
+describe("frameDelay", () => {
+  test("base 133ms @450WPM", () => {
+    expect(RSVP_BASE_MS).toBe(133)
+    expect(frameDelay("casa")).toBe(133)
+  })
+  test("fim de frase 2.2x", () => {
+    expect(frameDelay("fim.")).toBe(293)
+    expect(frameDelay("oi!")).toBe(293)
+    expect(frameDelay("quê?")).toBe(293)
+  })
+  test("vírgula 1.5x", () => {
+    expect(frameDelay("logo,")).toBe(200)
+    expect(frameDelay("nota;")).toBe(200)
+  })
+  test("palavra longa 1.1x", () => {
+    expect(frameDelay("extraordinário")).toBe(146)
+  })
+})
+
+function words(t: RsvpTokenizer, chunk: string) {
+  return t.push(chunk).filter((e) => e.type === "word")
+}
+
+describe("RsvpTokenizer", () => {
+  test("prosa simples, pontuação colada", () => {
+    const t = new RsvpTokenizer()
+    const evs = words(t, "O rato roeu a roupa. ")
+    expect(evs.map((e) => (e.type === "word" ? e.word : null))).toEqual(["O", "rato", "roeu", "a", "roupa."])
+    expect(evs.map((e) => (e.type === "word" ? e.seq : null))).toEqual([1, 2, 3, 4, 5])
+  })
+
+  test("última palavra sem trailing space segura até flush", () => {
+    const t = new RsvpTokenizer()
+    expect(words(t, "incomple")).toEqual([])
+    const flushed = t.flush().filter((e) => e.type === "word")
+    expect(flushed.map((e) => (e.type === "word" ? e.word : null))).toEqual(["incomple"])
+  })
+
+  test("lixo de formatação descartado", () => {
+    const t = new RsvpTokenizer()
+    const evs = words(t, "* item # titulo - ok ")
+    expect(evs.map((e) => (e.type === "word" ? e.word : null))).toEqual(["item", "titulo", "ok"])
+  })
+
+  test("bold markdown limpo, delay preservado", () => {
+    const t = new RsvpTokenizer()
+    const evs = t.push("**fim.** ")
+    expect(evs[0]).toMatchObject({ type: "word", word: "fim.", delayMs: 293 })
+  })
+
+  test("abertura parcial de fence não reemite prosa (sem duplicata)", () => {
+    const t = new RsvpTokenizer()
+    const a = t.push("penso `")
+    const b = t.push("`ainda ")
+    const all = [...a, ...b].filter((e) => e.type === "word")
+    // "penso" aparece exatamente 1x; "``" vira bypass vazio, "ainda" é prosa
+    expect(all.map((e) => (e.type === "word" ? e.word : null))).toEqual(["penso", "ainda"])
+  })
+
+  test("backtick solitário parcial não reemite prosa", () => {
+    const t = new RsvpTokenizer()
+    const a = t.push("olha `x")
+    const b = t.push("yz` fim ")
+    const all = [...a, ...b].filter((e) => e.type === "word")
