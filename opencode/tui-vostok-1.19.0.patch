+import { createMemo } from "solid-js"
+import { useTheme } from "../context/theme"
+import { useLocal } from "../context/local"
+
+// Cor do agente atual (vermelho build / Tron plan) p/ accents de navegação.
+// Cai pra theme.primary se não houver agente (comportamento original).
+export function useAgentColor() {
+  const { theme } = useTheme()
+  const local = useLocal()
+  return createMemo(() => {
+    const agent = local.agent.current()
+    return agent ? local.agent.color(agent.name) : theme.primary
+  })
+}
