+// Splash Vostok: emblema com gradiente escarlate→Tron por coluna e núcleo
+// branco. Escapes: `\_`→`_`, `\\`→`\` (a arte usa ambos como glifo);
+// depois dos escapes valem as marcas clássicas `_^~,`.
+const GRAD_FROM = RGBA.fromHex("#ff2a00")
+const GRAD_TO = RGBA.fromHex("#00d5ff")
+const CORE_FG = RGBA.fromHex("#ffffff")
+
+function lerp(a: RGBA, b: RGBA, t: number): RGBA {
+  return RGBA.fromValues(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, 1)
+}
+
+type Glyph = { ch: string; lit: boolean }
+
+function expand(raw: string): Glyph[] {
+  // Resolve escapes: `\X` vira literal X (lit=true pula as marcas abaixo).
+  const out: Glyph[] = []
+  for (let i = 0; i < raw.length; i++) {
+    if (raw[i] === "\\" && i + 1 < raw.length) {
+      out.push({ ch: raw[i + 1], lit: true })
+      i++
+    } else {
+      out.push({ ch: raw[i], lit: false })
+    }
+  }
+  return out
+}
 
